<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="PDF_simple_edit.Controls.PageSidebar"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:loc="using:PDF_simple_edit.Localization"
    xmlns:local="using:PDF_simple_edit">
    <Grid Background="{ThemeResource SubtleFillColorSecondaryBrush}" BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}" BorderThickness="0,0,1,0">
        <Grid.RowDefinitions>
            <RowDefinition Height="40"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <TextBlock Text="{loc:LocalizedString Key=Pages}" Margin="12,0" VerticalAlignment="Center" FontWeight="SemiBold" FontSize="13"/>
        <ListView x:Name="PageList" Grid.Row="1" Padding="4"
                  AllowDrop="True" CanReorderItems="False" CanDragItems="True"
                  SelectionMode="Extended">
            <ListView.ContextFlyout>
                <MenuFlyout x:Name="PageContextMenu">
                    <MenuFlyoutItem x:Name="SavePageImageMenuItem" Text="{loc:LocalizedString Key=SavePageAsImage}"/>
                    <MenuFlyoutItem x:Name="ExtractPagesMenuItem" Text="{loc:LocalizedString Key=ExtractSelectedPages}"/>
                    <MenuFlyoutItem x:Name="RotatePagesMenuItem" Text="{loc:LocalizedString Key=PageRotation}"/>
                    <MenuFlyoutItem x:Name="ResizePagesMenuItem" Text="{loc:LocalizedString Key=PageSizeSettings}"/>
                    <MenuFlyoutItem x:Name="DeletePagesMenuItem" Text="{loc:LocalizedString Key=DeleteSelectedPages}"/>
                </MenuFlyout>
            </ListView.ContextFlyout>
            <ListView.ItemTemplate>
                <DataTemplate x:DataType="local:PageThumbnailData">
                    <Grid Margin="{x:Bind DropMargin, Mode=OneWay}" Width="{x:Bind CardWidth, Mode=OneWay}">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <Border Background="{ThemeResource SolidBackgroundFillColorSecondaryBrush}"
                                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1"
                                CornerRadius="4" Width="{x:Bind ThumbnailWidth, Mode=OneWay}" Height="{x:Bind ThumbnailHeight, Mode=OneWay}"
                                HorizontalAlignment="Center" VerticalAlignment="Center">
                            <Image Source="{x:Bind Thumbnail, Mode=OneWay}" Stretch="Uniform"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <TextBlock Grid.Row="1" Text="{x:Bind PageLabel, Mode=OneWay}"
                                   HorizontalAlignment="Center" Margin="0,4,0,0" FontSize="11" Opacity="0.7"/>
                    </Grid>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>
    </Grid>
</UserControl>
