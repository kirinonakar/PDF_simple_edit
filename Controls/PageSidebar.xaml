<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="PDF_simple_edit.Controls.PageSidebar"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:PDF_simple_edit">
    <Grid Background="#0A000000" BorderBrush="#20000000" BorderThickness="0,0,1,0">
        <Grid.RowDefinitions>
            <RowDefinition Height="40"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <TextBlock Text="페이지" Margin="12,0" VerticalAlignment="Center" FontWeight="SemiBold" FontSize="13"/>
        <ListView x:Name="PageList" Grid.Row="1" Padding="4">
            <ListView.ItemTemplate>
                <DataTemplate x:DataType="local:PageThumbnailData">
                    <Grid Margin="8" Width="140">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <Border Background="#FFE0E0E0" BorderBrush="#40000000" BorderThickness="1"
                                CornerRadius="4" Width="120" Height="160"
                                HorizontalAlignment="Center" VerticalAlignment="Center">
                            <Image Source="{x:Bind Thumbnail, Mode=OneWay}" Stretch="Uniform"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <TextBlock Grid.Row="1" Text="{x:Bind PageLabel, Mode=OneWay}"
                                   HorizontalAlignment="Center" Margin="0,4,0,0" FontSize="11" Opacity="0.7"/>
                    </Grid>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>
    </Grid>
</UserControl>
