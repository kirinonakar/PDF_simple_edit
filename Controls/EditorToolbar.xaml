<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="PDF_simple_edit.Controls.EditorToolbar"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:loc="using:PDF_simple_edit.Localization">
    <Grid Padding="8,4" BorderBrush="#30000000" BorderThickness="0,0,0,1">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>
        <Grid Grid.Row="1" Grid.ColumnSpan="5" Margin="4,5,0,2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <Grid Grid.Column="0" Margin="0,0,16,0" VerticalAlignment="Center">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <TextBlock Text="{loc:LocalizedString Key=TextEditingMode}" VerticalAlignment="Center" Margin="0,0,10,0"/>
                <ComboBox x:Name="TextEditingModeComboBox" x:FieldModifier="public" Grid.Column="1" Width="168" SelectedIndex="1"
                          AutomationProperties.Name="{loc:LocalizedString Key=TextEditingMode}">
                    <ComboBoxItem Content="{loc:LocalizedString Key=Replacement}"/>
                    <ComboBoxItem Content="{loc:LocalizedString Key=PreserveOriginal}"/>
                </ComboBox>
                <TextBlock x:Name="TextEditingModeDescription" x:FieldModifier="public" Grid.Column="2" Margin="10,0,0,0"
                           VerticalAlignment="Center" FontSize="12" TextTrimming="CharacterEllipsis"
                           Text="{loc:LocalizedString Key=PreserveOriginalChangeFontSizeColorBoldItalicAlt}"/>
            </Grid>
            <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center" Spacing="2">
                <DropDownButton x:Name="DrawingButton" x:FieldModifier="public" Content="{loc:LocalizedString Key=Drawing}" IsEnabled="False" Padding="8,6" AutomationProperties.Name="{loc:LocalizedString Key=DrawingTools}" ToolTipService.ToolTip="{loc:LocalizedString Key=FreehandRectangleEllipseArrowPolygon}">
                    <DropDownButton.Flyout>
                        <MenuFlyout FlyoutBase.Placement="BottomEdgeAlignedRight">
                            <ToggleMenuFlyoutItem x:Name="DrawFreehandItem" x:FieldModifier="public" Text="{loc:LocalizedString Key=Freehand}" Tag="DrawFreehand"/>
                            <ToggleMenuFlyoutItem x:Name="DrawRectangleItem" x:FieldModifier="public" Text="{loc:LocalizedString Key=Rectangle}" Tag="DrawRectangle"/>
                            <ToggleMenuFlyoutItem x:Name="DrawEllipseItem" x:FieldModifier="public" Text="{loc:LocalizedString Key=Ellipse}" Tag="DrawEllipse"/>
                            <ToggleMenuFlyoutItem x:Name="DrawArrowItem" x:FieldModifier="public" Text="{loc:LocalizedString Key=Arrow}" Tag="DrawArrow"/>
                            <ToggleMenuFlyoutItem x:Name="DrawTriangleArrowItem" x:FieldModifier="public" Text="{loc:LocalizedString Key=TriangleArrow}" Tag="DrawTriangleArrow"/>
                            <ToggleMenuFlyoutItem x:Name="DrawOutlineArrowItem" x:FieldModifier="public" Text="{loc:LocalizedString Key=OutlineArrow}" Tag="DrawOutlineArrow"/>
                            <ToggleMenuFlyoutItem x:Name="DrawPolygonItem" x:FieldModifier="public" Text="{loc:LocalizedString Key=Polygon}" Tag="DrawPolygon"/>
                        </MenuFlyout>
                    </DropDownButton.Flyout>
                </DropDownButton>
                <DropDownButton x:Name="DrawingSettingsButton" x:FieldModifier="public" IsEnabled="False" Padding="6" Height="{Binding ActualHeight, ElementName=DrawingButton}" VerticalAlignment="Center" ToolTipService.ToolTip="{loc:LocalizedString Key=DrawingColorAndLineWidth}" AutomationProperties.Name="{loc:LocalizedString Key=DrawingSettings}">
                    <Border x:Name="DrawingColorIndicator" x:FieldModifier="public" Width="14" Height="4" Background="Red"/>
                    <DropDownButton.Flyout>
                        <Flyout FlyoutBase.Placement="BottomEdgeAlignedRight">
                            <StackPanel Spacing="10" Width="360">
                                <TextBlock Text="{loc:LocalizedString Key=DrawingLineSettings}" FontWeight="Bold"/>
                                <ColorPicker x:Name="DrawingColorPicker" x:FieldModifier="public" Width="340" HorizontalAlignment="Left" IsAlphaEnabled="False"/>
                                <StackPanel Orientation="Horizontal" Spacing="10">
                                    <TextBlock Text="{loc:LocalizedString Key=LineWidth}" VerticalAlignment="Center"/>
                                    <Slider x:Name="DrawingWidthSlider" x:FieldModifier="public" Minimum="0.5" Maximum="12" StepFrequency="0.5" Value="2" Width="150"/>
                                    <TextBlock x:Name="DrawingWidthText" x:FieldModifier="public" Text="2 pt" VerticalAlignment="Center"/>
                                </StackPanel>
                            </StackPanel>
                        </Flyout>
                    </DropDownButton.Flyout>
                </DropDownButton>
                <ToggleButton x:Name="SignatureButton" x:FieldModifier="public" ToolTipService.ToolTip="{loc:LocalizedString Key=DrawSignature}" IsEnabled="False" Padding="8,6" Height="{Binding ActualHeight, ElementName=DrawingButton}" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal" Spacing="4">
                        <FontIcon Glyph="&#xE929;" FontSize="16"/>
                        <Border x:Name="SignatureColorIndicator" x:FieldModifier="public" Width="12" Height="4" CornerRadius="1"
                                VerticalAlignment="Bottom" Margin="0,0,0,2" Background="Black"/>
                    </StackPanel>
                    <FlyoutBase.AttachedFlyout>
                        <Flyout x:Name="SignatureSettingsFlyout" x:FieldModifier="public" FlyoutBase.Placement="BottomEdgeAlignedRight">
                            <StackPanel Spacing="10" Width="360" HorizontalAlignment="Left">
                                <TextBlock Text="{loc:LocalizedString Key=SignatureLineSettings}" FontWeight="Bold"/>
                                <ColorPicker x:Name="SignatureColorPicker" x:FieldModifier="public" Width="340" HorizontalAlignment="Left"
                                             IsAlphaEnabled="False" IsColorSpectrumVisible="True"
                                             IsColorSliderVisible="True" IsHexInputVisible="True"/>
                                <StackPanel Orientation="Horizontal" Spacing="10">
                                    <TextBlock Text="{loc:LocalizedString Key=LineWidth}" VerticalAlignment="Center"/>
                                    <Slider x:Name="SignatureWidthSlider" x:FieldModifier="public" Minimum="0.5" Maximum="12"
                                            StepFrequency="0.5" Value="2" Width="150"/>
                                    <TextBlock x:Name="SignatureWidthText" x:FieldModifier="public" Text="2 pt" VerticalAlignment="Center" FontSize="12"/>
                                </StackPanel>
                            </StackPanel>
                        </Flyout>
                    </FlyoutBase.AttachedFlyout>
                </ToggleButton>
                <Button x:Name="SignatureSettingsButton" x:FieldModifier="public" ToolTipService.ToolTip="{loc:LocalizedString Key=SignatureSettings}"
                        Padding="4,6" Height="{Binding ActualHeight, ElementName=DrawingButton}" VerticalAlignment="Center" IsEnabled="False" Background="Transparent" BorderThickness="0">
                    <FontIcon Glyph="&#xE713;" FontSize="12"/>
                </Button>
            </StackPanel>
        </Grid>
        <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="2">
            <Button x:Name="OpenButton" x:FieldModifier="public" ToolTipService.ToolTip="{loc:LocalizedString Key=OpenCtrlO}" Padding="8,6" Background="Transparent" BorderThickness="0">
                <FontIcon Glyph="&#xE8E5;" FontSize="16"/>
            </Button>
            <Button x:Name="SaveButton" x:FieldModifier="public" ToolTipService.ToolTip="{loc:LocalizedString Key=SaveCtrlS}" Padding="8,6" IsEnabled="False" Background="Transparent" BorderThickness="0">
                <FontIcon Glyph="&#xE74E;" FontSize="16"/>
            </Button>
            <Button x:Name="SaveAsButton" x:FieldModifier="public" ToolTipService.ToolTip="{loc:LocalizedString Key=SaveAsCtrlShiftS}" Padding="8,6" IsEnabled="False" Background="Transparent" BorderThickness="0">
                <FontIcon Glyph="&#xE792;" FontSize="16"/>
            </Button>
            <Button x:Name="PrintButton" x:FieldModifier="public" ToolTipService.ToolTip="{loc:LocalizedString Key=PrintCtrlP}" Padding="8,6" IsEnabled="False" Background="Transparent" BorderThickness="0">
                <FontIcon Glyph="&#xE749;" FontSize="16"/>
            </Button>
            <AppBarSeparator/>
            <Button x:Name="UndoButton" x:FieldModifier="public" ToolTipService.ToolTip="{loc:LocalizedString Key=UndoCtrlZ}" Padding="8,6" IsEnabled="False" Background="Transparent" BorderThickness="0">
                <FontIcon Glyph="&#xE7A7;" FontSize="16"/>
            </Button>
            <Button x:Name="RedoButton" x:FieldModifier="public" ToolTipService.ToolTip="{loc:LocalizedString Key=RedoCtrlY}" Padding="8,6" IsEnabled="False" Background="Transparent" BorderThickness="0">
                <FontIcon Glyph="&#xE7A6;" FontSize="16"/>
            </Button>
            <AppBarSeparator/>
        </StackPanel>

        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="2">
            <ToggleButton x:Name="SelectButton" x:FieldModifier="public" ToolTipService.ToolTip="{loc:LocalizedString Key=SelectTextS}" AutomationProperties.Name="{loc:LocalizedString Key=SelectText}" IsEnabled="False" Padding="8,6">
                <FontIcon Glyph="&#xEF20;" FontSize="16"/>
            </ToggleButton>
            <ToggleButton x:Name="SelectGraphicsButton" x:FieldModifier="public" ToolTipService.ToolTip="{loc:LocalizedString Key=SelectGraphicsGTableBordersLinesShapesImages}" AutomationProperties.Name="{loc:LocalizedString Key=SelectGraphics}" IsEnabled="False" Padding="8,6" Height="{Binding ActualHeight, ElementName=SelectButton}" VerticalAlignment="Center">
                <PathIcon Width="16" Height="16" Data="M1,1 H15 V3 H1 Z M1,13 H15 V15 H1 Z M1,3 H3 V13 H1 Z M13,3 H15 V13 H13 Z M6,3 H7 V13 H6 Z M10,3 H11 V13 H10 Z M3,6 H13 V7 H3 Z M3,10 H13 V11 H3 Z" />
            </ToggleButton>
            <ToggleButton x:Name="AddTextButton" x:FieldModifier="public" ToolTipService.ToolTip="{loc:LocalizedString Key=AddTextA}" IsEnabled="False" Padding="8,6">
                <FontIcon Glyph="&#xE8D2;" FontSize="16"/>
            </ToggleButton>
            <ToggleButton x:Name="RedactRegionButton" x:FieldModifier="public" ToolTipService.ToolTip="{loc:LocalizedString Key=RedactRegionRRemoveContentInTheDraggedRegion}" AutomationProperties.Name="{loc:LocalizedString Key=RedactRegion}" IsEnabled="False" Padding="8,6">
                <FontIcon Glyph="&#xE75C;" FontSize="16"/>
            </ToggleButton>
            <ToggleButton x:Name="HighlightButton" x:FieldModifier="public" ToolTipService.ToolTip="{loc:LocalizedString Key=HighlightText}" IsEnabled="False" Padding="8,6">
                <StackPanel Orientation="Horizontal" Spacing="4">
                    <FontIcon Glyph="&#xE7E6;" FontSize="16"/>
                    <Border x:Name="HighlightIndicator" x:FieldModifier="public" Width="12" Height="4" CornerRadius="1"
                            VerticalAlignment="Bottom" Margin="0,0,0,2" Background="Yellow"/>
                </StackPanel>
                <FlyoutBase.AttachedFlyout>
                    <Flyout x:Name="HighlightSettingsFlyout" x:FieldModifier="public" FlyoutBase.Placement="BottomEdgeAlignedRight">
                        <StackPanel Spacing="10" Width="360" HorizontalAlignment="Left">
                            <TextBlock Text="{loc:LocalizedString Key=HighlightColorAndOpacity}" FontWeight="Bold"/>
                            <ColorPicker x:Name="HighlightPicker" x:FieldModifier="public" Width="340" HorizontalAlignment="Left"
                                         IsAlphaEnabled="True" IsColorSpectrumVisible="True"
                                         IsColorSliderVisible="True" IsHexInputVisible="True"/>
                            <StackPanel Orientation="Horizontal" Spacing="10">
                                <TextBlock Text="{loc:LocalizedString Key=Opacity}" VerticalAlignment="Center"/>
                                <Slider x:Name="HighlightOpacitySlider" x:FieldModifier="public" Minimum="0" Maximum="1"
                                        StepFrequency="0.05" Value="0.3" Width="100"/>
                                <TextBlock x:Name="HighlightOpacityText" x:FieldModifier="public" Text="30%" VerticalAlignment="Center" FontSize="12"/>
                            </StackPanel>
                        </StackPanel>
                    </Flyout>
                </FlyoutBase.AttachedFlyout>
            </ToggleButton>
            <Button x:Name="HighlightSettingsButton" x:FieldModifier="public" ToolTipService.ToolTip="{loc:LocalizedString Key=HighlightSettings}"
                    Padding="4,6" IsEnabled="False" Background="Transparent" BorderThickness="0">
                <FontIcon Glyph="&#xE713;" FontSize="12"/>
            </Button>
            <ToggleButton x:Name="ColorPickerButton" x:FieldModifier="public" ToolTipService.ToolTip="{loc:LocalizedString Key=ColorPickerEyedropper}" IsEnabled="False" Padding="8,6">
                <FontIcon Glyph="&#xEF3C;" FontSize="16"/>
            </ToggleButton>
            <Button x:Name="AddImageButton" x:FieldModifier="public" ToolTipService.ToolTip="{loc:LocalizedString Key=AddImage}" Padding="8,6"
                    IsEnabled="False" Background="Transparent" BorderThickness="0">
                <FontIcon Glyph="&#xE8B9;" FontSize="16"/>
            </Button>
            <AppBarSeparator/>
        </StackPanel>

        <StackPanel x:Name="FontControls" x:FieldModifier="public" Grid.Column="2" Orientation="Horizontal" Spacing="4">
            <ComboBox x:Name="FontFamilyComboBox" x:FieldModifier="public" Width="150" PlaceholderText="{loc:LocalizedString Key=Font}" VerticalAlignment="Center">
                <ComboBoxItem Content="맑은 고딕" IsSelected="True"/>
                <ComboBoxItem Content="굴림"/>
                <ComboBoxItem Content="돋움"/>
                <ComboBoxItem Content="바탕"/>
                <ComboBoxItem Content="궁서"/>
                <ComboBoxItem Content="나눔고딕"/>
                <ComboBoxItem Content="나눔명조"/>
                <ComboBoxItem Content="Arial"/>
                <ComboBoxItem Content="Times New Roman"/>
                <ComboBoxItem Content="Courier New"/>
                <ComboBoxItem Content="Verdana"/>
                <ComboBoxItem Content="Calibri"/>
                <ComboBoxItem Content="Segoe UI"/>
            </ComboBox>
            <ComboBox x:Name="FontSizeComboBox" x:FieldModifier="public" Width="90" VerticalAlignment="Center">
                <ComboBoxItem Content="8"/>
                <ComboBoxItem Content="9"/>
                <ComboBoxItem Content="10"/>
                <ComboBoxItem Content="11"/>
                <ComboBoxItem Content="12" IsSelected="True"/>
                <ComboBoxItem Content="14"/>
                <ComboBoxItem Content="16"/>
                <ComboBoxItem Content="18"/>
                <ComboBoxItem Content="20"/>
                <ComboBoxItem Content="24"/>
                <ComboBoxItem Content="28"/>
                <ComboBoxItem Content="32"/>
                <ComboBoxItem Content="36"/>
                <ComboBoxItem Content="48"/>
                <ComboBoxItem Content="72"/>
            </ComboBox>
            <ToggleButton x:Name="BoldButton" x:FieldModifier="public" ToolTipService.ToolTip="{loc:LocalizedString Key=Bold}" Padding="8,6">
                <FontIcon Glyph="&#xE8DD;" FontSize="14"/>
            </ToggleButton>
            <ToggleButton x:Name="ItalicButton" x:FieldModifier="public" ToolTipService.ToolTip="{loc:LocalizedString Key=Italic}" Padding="8,6">
                <FontIcon Glyph="&#xE8DB;" FontSize="14"/>
            </ToggleButton>
            <DropDownButton x:Name="FontColorButton" x:FieldModifier="public" ToolTipService.ToolTip="{loc:LocalizedString Key=TextColor}" Padding="8,6">
                <StackPanel Orientation="Horizontal" Spacing="4">
                    <FontIcon Glyph="&#xE8D3;" FontSize="14"/>
                    <Border x:Name="FontColorIndicatorElement" x:FieldModifier="public" Width="14" Height="4" CornerRadius="1" Background="Black"/>
                </StackPanel>
                <DropDownButton.Flyout>
                    <Flyout FlyoutBase.Placement="BottomEdgeAlignedRight">
                        <GridView x:Name="ColorPaletteGrid" x:FieldModifier="public" Width="224" HorizontalAlignment="Left"/>
                    </Flyout>
                </DropDownButton.Flyout>
            </DropDownButton>
            <AppBarSeparator/>
        </StackPanel>

        <StackPanel Grid.Column="4" Orientation="Horizontal" Spacing="2">
            <Button x:Name="ZoomOutButton" x:FieldModifier="public" Padding="8,6" ToolTipService.ToolTip="{loc:LocalizedString Key=ZoomOut}" Background="Transparent" BorderThickness="0">
                <FontIcon Glyph="&#xE71F;" FontSize="14"/>
            </Button>
            <TextBlock x:Name="ZoomText" x:FieldModifier="public" Text="100%" VerticalAlignment="Center" MinWidth="40" TextAlignment="Center" Margin="4,0"/>
            <Button x:Name="ZoomInButton" x:FieldModifier="public" Padding="8,6" ToolTipService.ToolTip="{loc:LocalizedString Key=ZoomIn}" Background="Transparent" BorderThickness="0">
                <FontIcon Glyph="&#xE8A3;" FontSize="14"/>
            </Button>
            <AppBarSeparator/>
            <Button x:Name="FitToPageButton" x:FieldModifier="public" Padding="8,6" ToolTipService.ToolTip="{loc:LocalizedString Key=FitToPage}" Background="Transparent" BorderThickness="0">
                <FontIcon Glyph="&#xE9A6;" FontSize="14"/>
            </Button>
        </StackPanel>
    </Grid>
</UserControl>
