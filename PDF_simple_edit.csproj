<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.17763.0</TargetPlatformMinVersion>
    <RootNamespace>PDF_simple_edit</RootNamespace>
    <DefaultLanguage>en-US</DefaultLanguage>
    <AssemblyName>PDFSimpleEditor</AssemblyName>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <Platforms>x64</Platforms>
    <RuntimeIdentifiers>win-x64</RuntimeIdentifiers>
    <PublishProfile Condition="'$(Platform)' != 'AnyCPU'">win-$(Platform).pubxml</PublishProfile>
    <UseWinUI>true</UseWinUI>
    <WindowsPackageType>None</WindowsPackageType>
    <WinUISDKReferences>true</WinUISDKReferences>
    <EnableMsixTooling>true</EnableMsixTooling>
    <Nullable>enable</Nullable>
    <DefineConstants>$(DefineConstants);DISABLE_XAML_GENERATED_MAIN</DefineConstants>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <WindowsAppSDKSelfContained>true</WindowsAppSDKSelfContained>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
    <PublishSingleFile>true</PublishSingleFile>
    <SelfContained>true</SelfContained>
    <DebugType>none</DebugType>
    <DebugSymbols>false</DebugSymbols>
  </PropertyGroup>

  <!-- Share the same .resw files with unpackaged and single-file deployments. -->
  <ItemGroup>
    <EmbeddedResource Include="Strings\ko-KR\Resources.resw">
      <LogicalName>PDF_simple_edit.Strings.ko-KR.Resources.resw</LogicalName>
      <WithCulture>false</WithCulture>
    </EmbeddedResource>
    <EmbeddedResource Include="Strings\en-US\Resources.resw">
      <LogicalName>PDF_simple_edit.Strings.en-US.Resources.resw</LogicalName>
      <WithCulture>false</WithCulture>
    </EmbeddedResource>
  </ItemGroup>

  <!-- Embed the manifest version so packaged and unpackaged apps share one source. -->
  <Target Name="ReadAppManifestVersion" BeforeTargets="GetAssemblyVersion">
    <XmlPeek XmlInputPath="$(MSBuildProjectDirectory)\Package.appxmanifest" Query="/*[local-name()='Package']/*[local-name()='Identity']/@Version">
      <Output TaskParameter="Result" PropertyName="AppManifestVersion" />
    </XmlPeek>
    <Error Condition="'$(AppManifestVersion)' == ''" Text="Package.appxmanifest must specify Identity/@Version." />
    <PropertyGroup>
      <Version>$(AppManifestVersion)</Version>
      <AssemblyVersion>$(AppManifestVersion)</AssemblyVersion>
      <FileVersion>$(AppManifestVersion)</FileVersion>
      <InformationalVersion>$(AppManifestVersion)</InformationalVersion>
    </PropertyGroup>
  </Target>

  <ItemGroup>
    <!-- Keep local diagnostic probes out of the application compilation. -->
    <Compile Remove="tmp\**" />
    <Compile Remove="tests\**" />
    <None Remove="tmp\**" />
    <None Remove="tests\**" />
    <Content Remove="tmp\**" />
    <Content Remove="tests\**" />
    <!-- Regression-rendering artifacts are generated by tests, not app assets. -->
    <Content Remove="output\**" />
    <None Remove="output\**" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="Assets\SplashScreen.scale-200.png" />
    <Content Include="Assets\LockScreenLogo.scale-200.png" />
    <Content Include="Assets\Square150x150Logo.scale-200.png" />
    <Content Include="Assets\Square44x44Logo.scale-200.png" />
    <Content Include="Assets\Square44x44Logo.targetsize-24_altform-unplated.png" />
    <Content Include="Assets\StoreLogo.png" />
    <Content Include="Assets\Wide310x150Logo.scale-200.png" />
    <Content Include="Assets\app.ico">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

  <ItemGroup>
    <Manifest Include="$(ApplicationManifest)" />
  </ItemGroup>

  <ItemGroup Condition="'$(DisableMsixProjectCapabilityAddedByProject)'!='true' and '$(EnableMsixTooling)'=='true'">
    <ProjectCapability Include="Msix" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="itext" Version="9.8.0" />
    <PackageReference Include="itext.bouncy-castle-adapter" Version="9.8.0" />
    <!-- pdfSweep 5.0.8 ships only net461 assets; the application still targets .NET 10. -->
    <PackageReference Include="itext.pdfsweep" Version="5.0.8" NoWarn="NU1701" />
    <!-- pdfSweep's partial-image cleanup loads System.Drawing at runtime. -->
    <PackageReference Include="System.Drawing.Common" Version="10.0.14" />
    <PackageReference Include="Microsoft.Windows.SDK.BuildTools" Version="10.0.28000.2957" />
    <!-- Reference WinUI directly to avoid the umbrella package's AI/ML dependencies. -->
    <PackageReference Include="Microsoft.WindowsAppSDK.WinUI" Version="2.6.5" />

  </ItemGroup>

  <PropertyGroup Condition="'$(DisableHasPackageAndPublishMenuAddedByProject)'!='true' and '$(EnableMsixTooling)'=='true'">
    <HasPackageAndPublishMenu>true</HasPackageAndPublishMenu>
  </PropertyGroup>

  <PropertyGroup>
    <PublishReadyToRun Condition="'$(Configuration)' == 'Debug'">False</PublishReadyToRun>
    <PublishReadyToRun Condition="'$(Configuration)' != 'Debug'">False</PublishReadyToRun>
    <PublishTrimmed>False</PublishTrimmed>
    <SuppressTrimAnalysisWarnings>true</SuppressTrimAnalysisWarnings>
    <ApplicationIcon>Assets\app.ico</ApplicationIcon>
  </PropertyGroup>
</Project>
