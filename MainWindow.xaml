<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="PDF_simple_edit.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:PDF_simple_edit"
    xmlns:controls="using:PDF_simple_edit.Controls"
    xmlns:loc="using:PDF_simple_edit.Localization"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Title="PDF Simple Editor">

    <!--
    <Window.SystemBackdrop>
        <MicaBackdrop />
    </Window.SystemBackdrop>
    -->

    <Grid x:Name="RootGrid" Background="{ThemeResource ApplicationPageBackgroundThemeBrush}"
          AllowDrop="True" DragOver="Grid_DragOver" Drop="Grid_Drop"
          KeyDown="MainWindow_KeyDown"
          KeyUp="MainWindow_KeyUp">
        <Grid.RowDefinitions>
            <RowDefinition Height="48"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="32"/>
        </Grid.RowDefinitions>

        <!-- Custom Title Bar -->
        <Grid x:Name="AppTitleBar" Grid.Row="0" Background="Transparent">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="16,0,0,0">
                <Image Source="ms-appx:///Assets/pdf_edit.png" Width="16" Height="16"
                       Stretch="Uniform" VerticalAlignment="Center"/>
                <TextBlock x:Name="TitleText" Text="PDF Simple Editor" Margin="12,0,0,0"
                           Style="{StaticResource CaptionTextBlockStyle}"
                           VerticalAlignment="Center"/>
            </StackPanel>
        </Grid>

        <controls:EditorMenuBar x:Name="EditorMenu" Grid.Row="1"/>

        <controls:EditorToolbar x:Name="EditorToolbar" Grid.Row="2"/>

        <!-- Tabs -->
        <TabView x:Name="DocTabView" Grid.Row="3"
                 VerticalAlignment="Bottom"
                 TabItemsSource="{x:Bind _tabs, Mode=OneWay}"
                 AddTabButtonClick="DocTabView_AddTabButtonClick"
                 TabCloseRequested="DocTabView_TabCloseRequested"
                 SelectionChanged="DocTabView_SelectionChanged">
            <TabView.TabItemTemplate>
                <DataTemplate x:DataType="local:PdfDocumentTab">
                    <TabViewItem Header="{x:Bind Header, Mode=OneWay}" IsClosable="True">
                        <TabViewItem.IconSource>
                            <FontIconSource Glyph="&#xEA90;"/>
                        </TabViewItem.IconSource>
                    </TabViewItem>
                </DataTemplate>
            </TabView.TabItemTemplate>
        </TabView>

        <!-- Content Area -->
        <Grid x:Name="EditorContentArea" Grid.Row="4">
            <Grid.Resources>
                <Style TargetType="controls:SidebarResizeHandle">
                    <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="controls:SidebarResizeHandle">
                        <Border Background="{TemplateBinding Background}"/>
                    </ControlTemplate></Setter.Value></Setter>
                </Style>
            </Grid.Resources>
            <Grid.ColumnDefinitions>
                <ColumnDefinition x:Name="PagePanelColumn" Width="200"/>
                <ColumnDefinition x:Name="PageGripColumn" Width="5"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition x:Name="FindGripColumn" Width="0"/>
                <ColumnDefinition x:Name="FindPanelColumn" Width="0"/>
                <ColumnDefinition x:Name="CommentGripColumn" Width="0"/>
                <ColumnDefinition x:Name="CommentPanelColumn" Width="0"/>
            </Grid.ColumnDefinitions>

            <controls:PageSidebar x:Name="PagePanel" Grid.Column="0"/>

            <controls:SidebarResizeHandle x:Name="PagePanelGrip" Grid.Column="1" Background="{ThemeResource DividerStrokeColorDefaultBrush}" AutomationProperties.Name="{loc:LocalizedString Key=ResizePageSidebar}"/>
            <controls:PdfEditorSurface x:Name="PdfSurface" Grid.Column="2"/>

            <controls:SidebarResizeHandle x:Name="FindPanelGrip" Grid.Column="3" Background="{ThemeResource DividerStrokeColorDefaultBrush}" AutomationProperties.Name="{loc:LocalizedString Key=ResizeSearchSidebar}"/>
            <controls:FindPanelControl x:Name="FindPanel" Grid.Column="4" Visibility="Collapsed"/>
            <controls:SidebarResizeHandle x:Name="CommentPanelGrip" Grid.Column="5" Background="{ThemeResource DividerStrokeColorDefaultBrush}" AutomationProperties.Name="{loc:LocalizedString Key=ResizeCommentSidebar}"/>
            <controls:CommentSidebar x:Name="CommentPanel" Grid.Column="6" Visibility="Collapsed"/>
        </Grid>

        <controls:EditorStatusBar x:Name="StatusBar" Grid.Row="5"/>
    </Grid>
</Window>
