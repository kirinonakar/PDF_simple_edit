<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="itext" Version="9.5.0" />
    <PackageReference Include="itext.bouncy-castle-adapter" Version="9.5.0" />
    <PackageReference Include="PDFiumCore" Version="154.0.8035" />
    <PackageReference Include="Newtonsoft.Json" Version="13.0.4" />
    <Compile Include="../../Models/NativePdfText.cs" Link="Models/NativePdfText.cs" />
    <Compile Include="../../Models/PdfAnnotation.cs" Link="Models/PdfAnnotation.cs" />
    <Compile Include="../../Helpers/PdfFontMetadataResolver.cs" Link="Helpers/PdfFontMetadataResolver.cs" />
    <Compile Include="../../Services/NativePdfText*.cs" Link="Services/%(Filename).cs" />
    <Compile Include="../../Services/NativePdfParagraphLayout.cs" Link="Services/NativePdfParagraphLayout.cs" />
    <Compile Include="../../Services/NativePdfGlyphGeometry.cs" Link="Services/NativePdfGlyphGeometry.cs" />
    <Compile Include="../../Services/PdfDisplayColorService.cs" Link="Services/PdfDisplayColorService.cs" />
    <Compile Include="../../Services/InstalledFontService.cs" Link="Services/InstalledFontService.cs" />
  </ItemGroup>
</Project>
